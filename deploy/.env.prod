# ── Database (connects to accounts360-db container on internal network) ──
DB_HOST=accounts360-db
DB_PORT=3306
DB_NAME=accounts360tech
DB_USER=a360user
DB_PASS=A360@Secure#2026

# ── JWT (generated random secret) ───────────────────────────────────────
JWT_SECRET=8f3a92c1e4b7d6f05a2e9c8d1b4f7a3e6c9d2b5f8a1e4c7d0b3f6a9e2c5d8b1
JWT_EXPIRY=86400
