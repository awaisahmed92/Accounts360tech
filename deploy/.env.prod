APP_DEBUG=false
APP_URL=https://accounts360techx.com

# ── Google Document AI (set to 1 for real OCR, 0 for mock data) ─────────
DOCUMENT_AI_ENABLED=1
GCP_PROJECT_ID=accounts360techx
GCP_PROCESSOR_ID=fb3a29fd7f1c11cb
GCP_CREDENTIALS_PATH=/opt/accounts360techx/keys/docai-service-account.json

# ── Mail (for password reset emails — configure your SMTP) ──────────────
